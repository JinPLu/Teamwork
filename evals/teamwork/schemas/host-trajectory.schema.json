{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teamwork installed host observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "host", "host_executable", "host_version", "profile",
    "case_name", "started_at", "finished_at", "selected_skill", "requested_authority",
    "route_observed", "agent_observations", "tool_observations", "final_output",
    "scenario_verification", "candidate_artifact", "exit_status", "status", "failure_classification"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "teamwork_host_observation"},
    "host": {"enum": ["codex", "cursor", "claude"]},
    "host_executable": {"type": ["string", "null"]},
    "host_version": {"type": "string"},
    "profile": {"enum": ["performance-first", "cost-first"]},
    "case_name": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "selected_skill": {"type": "string", "minLength": 1},
    "requested_authority": {"enum": ["read-only", "workspace-write"]},
    "route_observed": {"type": "boolean"},
    "agent_observations": {
      "type": "array",
      "items": {"enum": ["researcher", "explorer", "debugger", "challenger", "planner", "reviewer", "worker", "writer"]},
      "uniqueItems": true
    },
    "tool_observations": {"type": "array", "items": {"type": "string"}},
    "final_output": {"type": "string"},
    "scenario_verification": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "candidate_artifact": {"type": ["string", "null"]},
    "exit_status": {"type": ["integer", "null"]},
    "status": {"enum": ["PASS", "FAIL", "UNSUPPORTED"]},
    "failure_classification": {"type": ["string", "null"]}
  }
}
