{
  "evidence": "Static Debug behavior fixture.",
  "expected": {
    "capability": "debug",
    "language": "en",
    "requires": [
      "actual-failure-first",
      "authorized-fix-only",
      "discriminating-evidence",
      "frozen-failure-signature",
      "hypothesis-before-probes",
      "new-failure-split",
      "no-review-before-cause",
      "no-scope-broadening",
      "one-discriminating-experiment",
      "prediction-falsifier-mapping",
      "ranked-hypothesis-ledger",
      "rejected-hypotheses",
      "same-path-rerun"
    ],
    "scenario": "diagnose-and-fix"
  },
  "id": "debug-diagnose-en",
  "must": [
    "freeze the actual failure, rank 3-5 hypotheses with predictions and falsifiers before probes, run one discriminating experiment at a time, record rejected hypotheses, and rerun the same path after a narrow authorized fix"
  ],
  "must_not": [
    "broaden scope, silently pivot to a new failure, invoke Review while the cause is unknown, recollaborate unrelated code, or guess a fix before evidence"
  ],
  "platforms": [
    "codex",
    "cursor",
    "claude"
  ],
  "producers": [
    {
      "class": "root-policy",
      "source": "scripts/install/policy.sh"
    },
    {
      "class": "skill",
      "source": "skills/teamwork-debug/SKILL.md"
    },
    {
      "class": "role-template",
      "source": "templates/codex-agents/teamwork-debugger.toml"
    },
    {
      "class": "role-template",
      "source": "templates/cursor-agents/debugger.md"
    },
    {
      "class": "role-template",
      "source": "templates/claude-agents/debugger.md"
    }
  ],
  "prompt": "The integration test now fails intermittently with an unknown exit code. Diagnose it and apply only an already-authorized narrow fix.",
